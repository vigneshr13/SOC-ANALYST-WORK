<!-- Wazuh Custom Detection Rules -->
<!-- Location: /var/ossec/etc/rules/local_rules.xml -->
<!-- Author: Vignesh R -->
<!-- MITRE ATT&CK Mapped -->

<group name="custom_detection,">

  <!-- ══════════════════════════════════════════════ -->
  <!-- Rule: Privilege Escalation — Suspicious Service Installation -->
  <!-- MITRE ATT&CK: T1543.003 (Create or Modify System Process: Windows Service) -->
  <!-- ══════════════════════════════════════════════ -->
  <rule id="100001" level="12">
    <if_sid>60009</if_sid>
    <field name="win.system.eventID">^7045$</field>
    <description>New service installed — potential privilege escalation (T1543.003)</description>
    <mitre>
      <id>T1543.003</id>
    </mitre>
    <options>no_full_log</options>
    <group>privilege_escalation,service_creation,</group>
  </rule>

  <!-- ══════════════════════════════════════════════ -->
  <!-- Rule: Suspicious Registry Modification -->
  <!-- MITRE ATT&CK: T1547.001 (Boot or Logon Autostart Execution: Registry Run Keys) -->
  <!-- ══════════════════════════════════════════════ -->
  <rule id="100002" level="10">
    <if_sid>61600</if_sid>
    <field name="win.eventdata.targetObject">\\\\CurrentVersion\\\\Run</field>
    <description>Registry Run key modified — potential persistence mechanism (T1547.001)</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
    <group>persistence,registry_modification,</group>
  </rule>

  <!-- ══════════════════════════════════════════════ -->
  <!-- Rule: Suspicious PowerShell Execution with Encoded Command -->
  <!-- MITRE ATT&CK: T1059.001 (Command and Scripting Interpreter: PowerShell) -->
  <!-- ══════════════════════════════════════════════ -->
  <rule id="100003" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.commandLine">-[Ee]nc[oded]*[Cc]ommand</field>
    <description>PowerShell executed with encoded command — potential execution technique (T1059.001)</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
    <group>execution,powershell,</group>
  </rule>

  <!-- ══════════════════════════════════════════════ -->
  <!-- Rule: Multiple Failed Logins (Brute Force Indicator) -->
  <!-- MITRE ATT&CK: T1110 (Brute Force) -->
  <!-- ══════════════════════════════════════════════ -->
  <rule id="100004" level="10" frequency="5" timeframe="120">
    <if_matched_sid>60122</if_matched_sid>
    <description>Multiple failed login attempts detected — possible brute force (T1110)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>credential_access,brute_force,</group>
  </rule>

  <!-- ══════════════════════════════════════════════ -->
  <!-- Rule: Unauthorised Scheduled Task Creation -->
  <!-- MITRE ATT&CK: T1053.005 (Scheduled Task/Job: Scheduled Task) -->
  <!-- ══════════════════════════════════════════════ -->
  <rule id="100005" level="10">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image">schtasks.exe</field>
    <field name="win.eventdata.commandLine">/[Cc]reate</field>
    <description>Scheduled task creation detected — potential persistence (T1053.005)</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
    <group>persistence,scheduled_task,</group>
  </rule>

</group>

